# PostgreSQL connection string for local development. In docker compose the
# app/migrate services get their own DATABASE_URL pointing at the db service.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/excel_trainer

# Secret used to sign auth tokens (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=

# Base URL of the app, no trailing slash. Drives auth baseURL, metadataBase,
# the Caddy site address, and is baked into static routes at Docker build time.
BASE_URL=http://localhost:3000

# Password of the dockerized PostgreSQL (docker compose only; used to build
# the in-network DATABASE_URL for the app and migrate services)
POSTGRES_PASSWORD=
